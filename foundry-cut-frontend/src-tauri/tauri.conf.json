{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foundry Cut",
  "version": "1.0.0",
  "identifier": "com.hansonfoundry.cut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foundry Cut",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "copyright": "© 2026 Hanson Foundry",
    "shortDescription": "Local offline audio stem separation with Demucs",
    "longDescription": "Drop a song and split it into vocals, drums, bass, and instruments locally on your Mac.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "exceptionDomain": "localhost",
      "signingIdentity": "Apple Distribution",
      "providerShortName": "TEAMID"
    }
  }
}
